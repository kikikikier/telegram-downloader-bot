TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_API_ID=replace_me
TELEGRAM_API_HASH=replace_me
BOT_TELEGRAM_PROXY=http://127.0.0.1:18080
BOT_YTDLP_PROXY=http://127.0.0.1:18080
BOT_GALLERY_DL_PROXY=http://127.0.0.1:18080
BOT_DIRECT_PROXY=http://127.0.0.1:18080
BOT_MTPROTO_PROXY=http://127.0.0.1:18080
BOT_LOG_LEVEL=INFO
BOT_ENABLE_FFMPEG_MERGE=0
# Optional Instagram-specific cookies, in Netscape cookies.txt format.
# BOT_INSTAGRAM_COOKIES_FILE=/home/codex/telegram-downloader-bot/instagram-cookies.txt

# Cloud Bot API: 49 MB practical send limit.
# Local Bot API server: set both lines below and run telegram-bot-api with --local.
# BOT_API_BASE=http://127.0.0.1:8081
# BOT_API_LOCAL=1

# Large-file behavior.
BOT_MAX_MB=49
BOT_PREVIEW_MAX_MB=49
BOT_PART_MB=48
BOT_DOWNLOAD_MAX_MB=0
BOT_DOWNLOAD_TIMEOUT=900
BOT_UPLOAD_TIMEOUT=7200
BOT_MTPROTO_MAX_MB=2000
BOT_LARGE_UPLOAD_MODE=document
BOT_CLEANUP_DELAY_SECONDS=60
BOT_CLEANUP_SWEEP_SECONDS=30
