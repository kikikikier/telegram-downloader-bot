TELEGRAM_BOT_TOKEN=replace_me
BOT_LOG_LEVEL=INFO
BOT_ENABLE_FFMPEG_MERGE=1

# Optional Telegram app credentials for large MTProto uploads.
# TELEGRAM_API_ID=replace_me
# TELEGRAM_API_HASH=replace_me

# Optional proxy URLs.
# BOT_TELEGRAM_PROXY=http://127.0.0.1:PORT
# BOT_YTDLP_PROXY=http://127.0.0.1:PORT
# BOT_GALLERY_DL_PROXY=http://127.0.0.1:PORT
# BOT_DIRECT_PROXY=http://127.0.0.1:PORT
# BOT_MTPROTO_PROXY=http://127.0.0.1:PORT

# Optional Instagram-specific cookies, in Netscape cookies.txt format.
# BOT_INSTAGRAM_COOKIES_FILE=./instagram-cookies.txt

# Cloud Bot API: 49 MB practical send limit.
# Local Bot API server: set both lines below and run telegram-bot-api with --local.
# BOT_API_BASE=http://127.0.0.1:8081
# BOT_API_LOCAL=1

# Large-file behavior.
BOT_MAX_MB=49
BOT_PREVIEW_MAX_MB=49
BOT_DOWNLOAD_MAX_MB=0
BOT_DOWNLOAD_TIMEOUT=900
BOT_UPLOAD_TIMEOUT=7200
BOT_MTPROTO_MAX_MB=2000
BOT_MTPROTO_RETRIES=3
BOT_MTPROTO_RETRY_DELAY_SECONDS=5
BOT_LARGE_UPLOAD_MODE=document
BOT_CLEANUP_DELAY_SECONDS=60
BOT_CLEANUP_SWEEP_SECONDS=30
BOT_STARTUP_TMP_MAX_AGE_MINUTES=30
BOT_AUTO_UPDATE_DEPS=1
